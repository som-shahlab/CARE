# API configuration. Copy this file to .env and fill in your keys.
# .env is gitignored — never commit real keys.

# API gateway key (GPT / Llama / Claude / Gemini endpoints).
LLM_API_KEY=your_api_key_here

# Optional: AWS Bedrock-hosted models (e.g. Claude Opus).
# Only needed if you set CRC_SUMMARIZER_MODEL=bedrock/... etc.
BEDROCK_API_KEY=
