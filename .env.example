# API configuration. Copy this file to .env and fill in your keys.
# .env is gitignored — never commit real keys.

# Stanford Healthcare APIM key (GPT / Llama / Claude / Gemini endpoints).
SECUREGPT_API_KEY=your_api_key_here

# Optional: AWS Bedrock-hosted models via Stanford AI Hub (e.g. Claude Opus).
# Only needed if you set CRC_SUMMARIZER_MODEL=bedrock/... etc.
BEDROCK_API_KEY=
